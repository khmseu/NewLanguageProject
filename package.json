{
  "name": "new-language-compiler-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc --project tsconfig.build.json",
    "parse": "npm run --silent build && node dist/cli/main.js",
    "smoke:exports": "npm run build && node tests/built-exports.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@unicode/unicode-18.0.0": "2.1.0"
  }
}
